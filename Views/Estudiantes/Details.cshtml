@model SistemaMatriculaURA.Models.Estudiante

@{
    ViewData["Title"] = "Detalle Estudiante";
}

<h2>Detalle de Estudiante</h2>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Nombre</dt>
    <dd class="col-sm-10">@Model.Nombre</dd>

    <dt class="col-sm-2">Correo</dt>
    <dd class="col-sm-10">@Model.Correo</dd>

    <dt class="col-sm-2">Carrera</dt>
    <dd class="col-sm-10">@Model.Carrera?.Nombre</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
