@model SistemaMatriculaURA.Models.PaginatedList<SistemaMatriculaURA.Models.Curso>

<div class="container mt-4">
    <h1>Gestión de Cursos</h1>

    <a asp-controller="CursosAdmin" asp-action="Create" class="btn btn-primary mb-3">+ Crear Curso</a>

    <p class="text-muted">@Model.TotalCount curso(s) en total.</p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Carrera</th>
                <th>Docente</th>
                <th>Modalidad</th>
                <th>Sede</th>
                <th>Horario</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Codigo</td>
                <td>@c.Nombre</td>
                <td>@c.Creditos</td>
                <td>@c.Carrera?.Nombre</td>
                <td>@c.Docente?.Nombre</td>
                <td>@c.Modalidad</td>
                <td>@c.Sede</td>
                <td>@c.Horario</td>
                <td>
                    @await Component.InvokeAsync("EstadoBadge", new { estado = c.Estado })
                </td>
                <td>
                    <a asp-controller="CursosAdmin" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-sm">Editar</a>

<a asp-controller="CursosAdmin" asp-action="Details" asp-route-id="@c.Id" class="btn btn-info btn-sm">Detalles</a>

<a asp-controller="CursosAdmin" asp-action="Delete" asp-route-id="@c.Id" class="btn btn-danger btn-sm">Eliminar</a>

                </td>
            </tr>
        }
        </tbody>
    </table>

    @await Component.InvokeAsync("Pagination", new { pageIndex = Model.PageIndex, totalPages = Model.TotalPages, action = "Index" })
</div>
