@model SistemaMatriculaURA.Models.PaginatedList<SistemaMatriculaURA.Models.Curso>
@{
    var modalidades = (string[])ViewBag.Modalidades;
    int? creditosSeleccionado = ViewBag.CreditosSeleccionado;
    string? modalidadSeleccionada = ViewBag.ModalidadSeleccionada;
    bool soloSinAsignar = ViewBag.SoloSinAsignar;
}

<div class="container mt-4">
    <h1>Gestión de Cursos</h1>

    <a asp-controller="CursosAdmin" asp-action="Create" class="btn btn-primary mb-3">+ Crear Curso</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form class="row g-2 align-items-end mb-3" asp-action="Index" method="get">
        <div class="col-auto">
            <label class="form-label">Créditos</label>
            <select name="creditos" class="form-select">
                <option value="">Todos</option>
                @for (var i = 2; i <= 4; i++)
                {
                    <option value="@i" selected="@(creditosSeleccionado == i ? "selected" : null)">@i</option>
                }
            </select>
        </div>

        <div class="col-auto">
            <label class="form-label">Modalidad (tipo)</label>
            <select name="modalidad" class="form-select">
                <option value="">Todas</option>
                @foreach (var m in modalidades)
                {
                    <option value="@m" selected="@(m == modalidadSeleccionada ? "selected" : null)">@m</option>
                }
            </select>
        </div>

        <div class="col-auto">
            <label class="form-label">Buscar</label>
            <input type="text" name="busqueda" class="form-control" placeholder="Código o nombre" value="@ViewBag.Busqueda" />
        </div>

        <div class="col-auto form-check mb-2">
            <input type="checkbox" name="soloSinAsignar" value="true" class="form-check-input" id="soloSinAsignar" checked="@(soloSinAsignar ? "checked" : null)" />
            <label class="form-check-label" for="soloSinAsignar">Solo sin profesor asignado</label>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <p class="text-muted">@Model.TotalCount curso(s) encontrado(s).</p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Costo</th>
                <th>Carrera</th>
                <th>Docente</th>
                <th>Modalidad</th>
                <th>Sede</th>
                <th>Horario</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Codigo</td>
                <td>@c.Nombre</td>
                <td>@c.Creditos</td>
                <td>&#8353;@c.Costo.ToString("N0")</td>
                <td>@c.Carrera?.Nombre</td>
                <td>
                    @if (c.Docente != null)
                    {
                        @c.Docente.Nombre
                    }
                    else
                    {
                        <span class="badge bg-danger">Sin asignar</span>
                    }
                </td>
                <td>@c.Modalidad</td>
                <td>@c.Sede</td>
                <td>@c.Horario</td>
                <td>
                    @await Component.InvokeAsync("EstadoBadge", new { estado = c.Estado })
                </td>
                <td>
                    <a asp-controller="CursosAdmin" asp-action="Edit" asp-route-id="@c.Id" class="btn btn-warning btn-sm">Editar</a>

<a asp-controller="CursosAdmin" asp-action="Details" asp-route-id="@c.Id" class="btn btn-info btn-sm">Detalles</a>

<a asp-controller="CursosAdmin" asp-action="Delete" asp-route-id="@c.Id" class="btn btn-danger btn-sm">Eliminar</a>

                </td>
            </tr>
        }
        </tbody>
    </table>

    @await Component.InvokeAsync("Pagination", new
    {
        pageIndex = Model.PageIndex,
        totalPages = Model.TotalPages,
        action = "Index",
        routeValues = new
        {
            creditos = ViewBag.CreditosSeleccionado,
            modalidad = ViewBag.ModalidadSeleccionada,
            busqueda = ViewBag.Busqueda,
            soloSinAsignar = ViewBag.SoloSinAsignar
        }
    })
</div>
