@model SistemaMatriculaURA.Models.Curso

<div class="container mt-4">
    <h1>Editar Curso</h1>

    <div class="ura-box p-4" style="max-width: 600px;">
       <form asp-action="Edit" asp-controller="CursosAdmin" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Codigo" class="form-label"></label>
                <input asp-for="Codigo" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Creditos" class="form-label"></label>
                <input asp-for="Creditos" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Costo" class="form-label">Costo (&#8353;)</label>
                <input asp-for="Costo" class="form-control" type="number" step="0.01" min="0" />
            </div>

            <div class="mb-3">
                <label asp-for="CarreraId" class="form-label"></label>
                <select asp-for="CarreraId" asp-items="ViewBag.CarreraId" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="DocenteId" class="form-label"></label>
                <select asp-for="DocenteId" asp-items="ViewBag.DocenteId" class="form-select">
                    <option value="">-- Sin asignar --</option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Modalidad" class="form-label"></label>
                <select asp-for="Modalidad" asp-items="ViewBag.Modalidades" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Sede" class="form-label"></label>
                <select asp-for="Sede" asp-items="ViewBag.Sedes" class="form-select"></select>
            </div>

            <div class="mb-3">
                <label asp-for="Horario" class="form-label"></label>
                <input asp-for="Horario" class="form-control" placeholder="Ej. Lun/Mié 18:00-20:00" />
            </div>

            <div class="mb-3">
                <label asp-for="Grupo" class="form-label"></label>
                <input asp-for="Grupo" class="form-control" placeholder="Ej. A" />
            </div>

            <div class="mb-3">
                <label asp-for="Aula" class="form-label"></label>
                <input asp-for="Aula" class="form-control" placeholder="Ej. Aula 204" />
            </div>

            <div class="mb-3">
                <label asp-for="Estado" class="form-label"></label>
                <select asp-for="Estado" asp-items="ViewBag.Estados" class="form-select"></select>
            </div>

            <button type="submit" class="btn btn-success">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
