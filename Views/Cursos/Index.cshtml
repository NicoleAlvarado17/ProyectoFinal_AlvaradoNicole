@model List<SistemaMatriculaURA.Models.Curso>

@{
    ViewData["Title"] = "Gestión de Cursos";
}

<div class="container mt-4">
    <h1 class="mb-3">Gestión de Cursos</h1>

    <a asp-action="Create" class="btn btn-primary mb-3">+ Crear Curso</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="ura-box p-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Carrera</th>
                    <th>Créditos</th>
                    <th>Modalidad</th>
                    <th>Sede</th>
                    <th>Horario</th>
                    <th>Profesor</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Codigo</td>
                        <td>@c.Nombre</td>
                        <td>@c.Carrera?.Nombre</td>
                        <td>@c.Creditos</td>
                        <td>@c.Modalidad</td>
                        <td>@c.Sede</td>
                        <td>@c.Horario</td>
                        <td>@c.Docente</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-info">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
