@model SistemaMatriculaURA.Models.Curso

<div class="container mt-4">
    <h1>Editar Curso</h1>

    <div class="ura-box p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Codigo"></label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Nombre"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Creditos"></label>
                <input asp-for="Creditos" class="form-control" type="number" />
                <span asp-validation-for="Creditos" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CarreraId"></label>
                <select asp-for="CarreraId" asp-items="ViewBag.CarreraId" class="form-select"></select>
                <span asp-validation-for="CarreraId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Modalidad"></label>
                <select asp-for="Modalidad" class="form-select">
                    <option>Virtual</option>
                    <option>Presencial</option>
                </select>
                <span asp-validation-for="Modalidad" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sede"></label>
                <select asp-for="Sede" class="form-select">
                    <option>San José</option>
                    <option>Heredia</option>
                    <option>Cartago</option>
                    <option>Alajuela</option>
                </select>
                <span asp-validation-for="Sede" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Horario"></label>
                <input asp-for="Horario" class="form-control" />
                <span asp-validation-for="Horario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Docente"></label>
                <select asp-for="Docente" asp-items="ViewBag.DocenteId" class="form-select"></select>
                <span asp-validation-for="Docente" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-success">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>
