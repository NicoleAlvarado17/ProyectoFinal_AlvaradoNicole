@model SistemaMatriculaURA.Models.Curso

@{
    ViewData["Title"] = "Detalles del Curso";
}

<div class="container mt-4">
    <h1>Detalles del Curso</h1>

    <div class="ura-box p-4">
        <p><strong>Código:</strong> @Model.Codigo</p>
        <p><strong>Nombre:</strong> @Model.Nombre</p>
        <p><strong>Carrera:</strong> @Model.Carrera?.Nombre</p>
        <p><strong>Créditos:</strong> @Model.Creditos</p>
        <p><strong>Modalidad:</strong> @Model.Modalidad</p>
        <p><strong>Sede:</strong> @Model.Sede</p>
        <p><strong>Horario:</strong> @Model.Horario</p>
        <p><strong>Profesor:</strong> @Model.Profesor</p>

        <a asp-action="Index" class="btn btn-secondary">Volver</a>
    </div>
</div>
