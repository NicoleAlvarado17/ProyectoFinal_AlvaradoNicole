@model List<ProyectoFinal_AlvaradoNicole.Controllers.MiCursoViewModel>

<div class="container mt-4">
    <h1>Mis Cursos</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Carrera</th>
                <th>Créditos</th>
                <th>Estado</th>
                <th>Fecha</th>
                <th>Horario</th>
                <th>Docente</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Codigo</td>
                    <td>@m.Nombre</td>
                    <td>@m.Carrera</td>
                    <td>@m.Creditos</td>
                    <td>@m.Estado</td>
                    <td>@m.Fecha.ToShortDateString()</td>
                    <td>@m.Horario</td>
                    <td>@m.Docente</td>
                    <td>
                        <form asp-action="Congelar" method="post" style="display:inline;">
                            <input type="hidden" name="matriculaId" value="@m.MatriculaId" />
                            <button class="btn btn-warning btn-sm">Congelar</button>
                        </form>

                        <form asp-action="Desmatricular" method="post" style="display:inline;">
                            <input type="hidden" name="cursoId" value="@m.CursoId" />
                            <button class="btn btn-danger btn-sm">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-action="Comprobante" class="btn btn-success">Descargar Comprobante PDF</a>
</div>
