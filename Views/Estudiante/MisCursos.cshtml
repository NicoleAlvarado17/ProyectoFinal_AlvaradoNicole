@model List<ProyectoFinal_AlvaradoNicole.Controllers.MiCursoViewModel>

@{
    ViewData["Title"] = "Mis Cursos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Mis Cursos</h1>
        <div>
            <a asp-controller="Estudiante" asp-action="Cursos" class="btn btn-warning">+ Matricular otro curso</a>
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary">&larr; Volver al Dashboard</a>
            <a asp-controller="Estudiante" asp-action="Comprobante" class="btn btn-primary">Descargar Comprobante PDF</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="ura-box p-4 text-center">
            <p class="text-muted mb-3">Todavía no tenés cursos matriculados.</p>
            <a asp-controller="Estudiante" asp-action="Cursos" class="btn btn-primary">Ver cursos disponibles</a>
        </div>
    }
    else
    {
        <div class="ura-box p-3">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Curso</th>
                        <th>Carrera</th>
                        <th>Créditos</th>
                        <th>Modalidad</th>
                        <th>Sede</th>
                        <th>Horario</th>
                        <th>Profesor</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var curso in Model)
                    {
                        <tr>
                            <td>@curso.Codigo</td>
                            <td>@curso.Nombre</td>
                            <td>@curso.Carrera</td>
                            <td>@curso.Creditos</td>
                            <td>@curso.Modalidad</td>
                            <td>@curso.Sede</td>
                            <td>@curso.Horario</td>
                            <td>@curso.Profesor</td>
                            <td>
                                <span class="badge bg-success">@curso.Estado</span>
                            </td>
                            <td>@curso.Fecha.ToString("dd/MM/yyyy")</td>

                            <td class="d-flex gap-2">

                                <!-- BOTÓN CONGELAR -->
                                <form asp-action="Congelar" method="post" class="d-inline">
                                    <input type="hidden" name="matriculaId" value="@curso.MatriculaId" />
                                    <button type="submit" class="btn btn-sm btn-secondary">
                                        Congelar
                                    </button>
                                </form>

                                
                                <form asp-action="Desmatricular" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Eliminar este curso de tu matrícula?');">
                                    <input type="hidden" name="cursoId" value="@curso.CursoId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Eliminar
                                    </button>
                                </form>

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ura-box p-3 mt-3 text-muted">
            Total: @Model.Count curso(s) · @Model.Sum(c => c.Creditos) créditos matriculados
        </div>
    }
</div>
