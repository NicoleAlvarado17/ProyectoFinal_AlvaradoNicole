@model SistemaMatriculaURA.Models.PaginatedList<ProyectoFinal_AlvaradoNicole.Controllers.CursoDisponibleViewModel>

<p class="text-muted">@Model.TotalCount curso(s) encontrado(s).</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Créditos</th>
            <th>Modalidad</th>
            <th>Carrera</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No hay cursos que coincidan con el filtro.</td></tr>
        }
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Codigo</td>
                <td>@c.Nombre</td>
                <td>@c.Creditos</td>
                <td>@c.Modalidad</td>
                <td>@c.CarreraNombre</td>
                <td>
                    @if (c.YaMatriculado)
                    {
                        <span class="badge bg-success">Matriculado</span>
                    }
                    else
                    {
                        <form asp-action="Matricular" method="post" class="d-inline">
                            <input type="hidden" name="cursoId" value="@c.Id" />
                            <button class="btn btn-primary btn-sm">Matricular</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@await Component.InvokeAsync("Pagination", new
{
    pageIndex = Model.PageIndex,
    totalPages = Model.TotalPages,
    action = "Cursos",
    routeValues = new
    {
        creditos = ViewBag.CreditosSeleccionado,
        modalidad = ViewBag.ModalidadSeleccionada,
        busqueda = ViewBag.Busqueda
    }
})
