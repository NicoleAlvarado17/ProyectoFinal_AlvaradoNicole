@model SistemaMatriculaURA.Models.PaginatedList<ProyectoFinal_AlvaradoNicole.Controllers.CursoDisponibleViewModel>
@{
    var modalidades = (string[])ViewBag.Modalidades;
    int? creditosSeleccionado = ViewBag.CreditosSeleccionado;
    string? modalidadSeleccionada = ViewBag.ModalidadSeleccionada;
}

<div class="container mt-4">
    <h1>Cursos Disponibles</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form id="formFiltroCursos" class="row g-2 align-items-end mb-3" asp-action="Cursos" method="get">
        <div class="col-auto">
            <label class="form-label">Créditos</label>
            <select name="creditos" id="filtroCreditos" class="form-select">
                <option value="">Todos</option>
                @for (var i = 1; i <= 6; i++)
                {
                    <option value="@i" selected="@(creditosSeleccionado == i ? "selected" : null)">@i</option>
                }
            </select>
        </div>

        <div class="col-auto">
            <label class="form-label">Modalidad</label>
            <select name="modalidad" id="filtroModalidad" class="form-select">
                <option value="">Todas</option>
                @foreach (var m in modalidades)
                {
                    <option value="@m" selected="@(m == modalidadSeleccionada ? "selected" : null)">@m</option>
                }
            </select>
        </div>

        <div class="col-auto">
            <label class="form-label">Buscar</label>
            <input type="text" name="busqueda" id="filtroBusqueda" class="form-control"
                   placeholder="Código o nombre del curso" value="@ViewBag.Busqueda" />
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Cursos" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div id="resultadoCursos">
        @await Html.PartialAsync("_CursosDisponiblesParcial", Model)
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $resultado = $('#resultadoCursos');

            function cargarCursos(url) {
                $.get(url, function (html) {
                    $resultado.html(html);
                });
            }

        
            $('#formFiltroCursos').on('submit', function (e) {
                e.preventDefault();
                var query = $(this).serialize();
                cargarCursos('@Url.Action("CursosParcial", "Estudiante")?' + query);
            });

            
            $resultado.on('click', 'a.page-link', function (e) {
                e.preventDefault();
                var href = $(this).attr('href');
                if (!href) return;
                var parcialUrl = href.replace('/Estudiante/Cursos', '/Estudiante/CursosParcial');
                cargarCursos(parcialUrl);
            });
        });
    </script>
}
