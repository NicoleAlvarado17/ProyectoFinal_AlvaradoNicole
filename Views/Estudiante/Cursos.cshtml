@model List<ProyectoFinal_AlvaradoNicole.Controllers.CursoDisponibleViewModel>

<div class="container mt-4">
    <h1>Cursos Disponibles</h1>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Créditos</th>
                <th>Carrera</th>
                <th>Acción</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Codigo</td>
                    <td>@c.Nombre</td>
                    <td>@c.Creditos</td>
                    <td>@c.CarreraNombre</td>
                    <td>
                        @if (c.YaMatriculado)
                        {
                            <span class="badge bg-success">Matriculado</span>
                        }
                        else
                        {
                            <form asp-action="Matricular" method="post">
                                <input type="hidden" name="cursoId" value="@c.Id" />
                                <button class="btn btn-primary btn-sm">Matricular</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
