@model List<ProyectoFinal_AlvaradoNicole.Controllers.CursoDisponibleViewModel>

@{
    ViewData["Title"] = "Cursos disponibles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Cursos disponibles</h1>
        <a asp-controller="Estudiante" asp-action="MisCursos" class="btn btn-warning me-2">Ver mis cursos matriculados</a>
<a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary">&larr; Volver al Dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="ura-box p-3">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Curso</th>
                    <th>Carrera</th>
                    <th>Créditos</th>
                    <th class="text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var curso in Model)
                {
                    <tr>
                        <td>@curso.Codigo</td>
                        <td>@curso.Nombre</td>
                        <td>@curso.CarreraNombre</td>
                        <td>@curso.Creditos</td>
                        <td class="text-end">
                            @if (curso.YaMatriculado)
                            {
                                <span class="badge bg-success">✔ Agregado</span>
                            }
                            else
                            {
                                <form asp-action="Matricular" method="post" class="d-inline">
                                    <input type="hidden" name="cursoId" value="@curso.Id" />
                                    <button type="submit" class="btn btn-sm btn-primary">Matricular</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>