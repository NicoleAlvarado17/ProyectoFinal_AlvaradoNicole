@model List<SistemaMatriculaURA.Models.Docente>

@{
    ViewData["Title"] = "Gestión de Profesores";
}

<div class="container mt-4">
    <h1 class="mb-3">Gestión de Profesores</h1>

    <a asp-action="Create" class="btn btn-primary mb-3">+ Registrar Profesor</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="ura-box ura-box-wide p-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Especialidad</th>
                    <th>Correo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>@d.Nombre</td>
                        <td>@d.Especialidad</td>
                        <td>@d.Correo</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@d.Id" class="btn btn-sm btn-info">Detalles</a>
                            <a asp-action="Edit" asp-route-id="@d.Id" class="btn btn-sm btn-warning">Editar</a>
                            <a asp-action="Delete" asp-route-id="@d.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
