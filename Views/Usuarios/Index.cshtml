@model List<UsuarioListItemViewModel>
@using SistemaMatriculaURA.Models

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Usuarios</h1>
        <a asp-action="Create" class="btn btn-warning">+ Crear usuario</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="ura-box ura-box-wide p-3">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Correo</th>
                    <th>Nombre completo</th>
                    <th>Rol(es)</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td>@u.FullName</td>
                        <td>@u.Roles</td>
                        <td class="text-end">
                            <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Eliminar a @u.Email?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>