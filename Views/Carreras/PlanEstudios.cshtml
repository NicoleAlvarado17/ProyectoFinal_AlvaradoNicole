@model SistemaMatriculaURA.Models.PaginatedList<SistemaMatriculaURA.Models.Curso>
@{
    var carrera = (SistemaMatriculaURA.Models.Carrera)ViewBag.Carrera;
    ViewData["Title"] = "Plan de Estudios - " + carrera.Nombre;
}

<div class="mb-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al inicio</a>
</div>

<h1>Plan de Estudios</h1>
<h4 class="text-muted mb-4">@carrera.Nombre (@carrera.Codigo)</h4>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay cursos publicados para esta carrera.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Código</th>
                <th>Curso</th>
                <th>Créditos</th>
                <th>Costo</th>
                <th>Modalidad</th>
                <th>Sede</th>
                <th>Horario</th>
                <th>Docente</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var curso in Model)
            {
                <tr>
                    <td>@curso.Codigo</td>
                    <td>@curso.Nombre</td>
                    <td>@curso.Creditos</td>
                    <td>&#8353;@curso.Costo.ToString("N0")</td>
                    <td>@curso.Modalidad</td>
                    <td>@curso.Sede</td>
                    <td>@curso.Horario</td>
                    <td>@(curso.Docente != null ? curso.Docente.Nombre : "Por asignar")</td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted">
        @Model.TotalCount curso(s) en el plan de estudios
        &nbsp;&middot;&nbsp;
        Total de créditos (esta página): <strong>@Model.Sum(c => c.Creditos)</strong>
        &nbsp;&middot;&nbsp;
        Costo (esta página): <strong>&#8353;@Model.Sum(c => c.Costo).ToString("N0")</strong>
    </p>

    @await Component.InvokeAsync("Pagination", new
    {
        pageIndex = Model.PageIndex,
        totalPages = Model.TotalPages,
        action = "PlanEstudios",
        routeValues = new { id = carrera.Id }
    })
}

<a asp-page="/Account/Register" class="btn btn-warning">Matricularme en esta carrera</a>
