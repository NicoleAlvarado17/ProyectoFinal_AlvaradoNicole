@model SistemaMatriculaURA.Models.PaginatedList<SistemaMatriculaURA.Models.Carrera>

@{
    ViewData["Title"] = "Carreras";
}

<h1>Carreras</h1>
<div class="mb-3">
    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">&larr; Volver al inicio</a>
    <a asp-action="Create" class="btn btn-primary">Crear nueva Carrera</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Código</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Nombre</td>
            <td>@item.Codigo</td>
            <td>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning ms-1">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger ms-1">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@await Component.InvokeAsync("Pagination", new { pageIndex = Model.PageIndex, totalPages = Model.TotalPages, action = "Index" })