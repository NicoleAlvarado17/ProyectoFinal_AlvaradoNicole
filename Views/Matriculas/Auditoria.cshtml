@model List<SistemaMatriculaURA.Models.Matricula>

@{
    ViewData["Title"] = "Auditoría de Matrículas";
}

<div class="container mt-4">
    <h1 class="mb-3">Auditoría de Matrículas</h1>

    <div class="ura-box ura-box-wide p-4 mb-4">
        <form method="get" class="row g-3">

            <div class="col-md-4">
                <label class="form-label">Estudiante</label>
                <select name="estudianteId" class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var e in ViewBag.Estudiantes)
                    {
                        <option value="@e.Id">@e.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Curso</label>
                <select name="cursoId" class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var c in ViewBag.Cursos)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select">
                    <option value="">-- Todos --</option>
                    @foreach (var est in ViewBag.Estados)
                    {
                        <option value="@est">@est</option>
                    }
                </select>
            </div>

            <div class="col-12 text-end">
                <button class="btn btn-primary">Filtrar</button>
            </div>
        </form>
    </div>

    <div class="ura-box ura-box-wide p-3">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Estudiante</th>
                    <th>Curso</th>
                    <th>Carrera</th>
                    <th>Estado</th>
                    <th>Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.Estudiante.Nombre</td>
                        <td>@m.Curso.Nombre</td>
                        <td>@m.Curso.Carrera.Nombre</td>
                        <td>@m.Estado</td>
                        <td>@m.Fecha.ToString("dd/MM/yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-info">Detalles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
