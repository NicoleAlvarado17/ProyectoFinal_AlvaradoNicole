@model SistemaMatriculaURA.Models.Docente
@{
    ViewData["Title"] = "Dashboard Docente";
}

<div class="container mt-4">

    <div class="ura-box p-4 mb-4">
        <h1 class="mb-1">Bienvenido, @Model.Nombre</h1>
        <p class="text-muted mb-0">Panel de Docente</p>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="ura-box p-4 h-100">
                <p class="text-muted mb-1">Cursos asignados</p>
                <h2 class="mb-0">@ViewBag.Cursos</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="ura-box p-4 h-100">
                <p class="text-muted mb-1">Estudiantes matriculados</p>
                <h2 class="mb-0">@ViewBag.Estudiantes</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="ura-box p-4 h-100">
                <p class="text-muted mb-1">Cuatrimestre actual</p>
                <h2 class="mb-0">II-2026</h2>
            </div>
        </div>
    </div>

    <div class="ura-box p-4 mt-4">
        <h4 class="mb-3">Mis cursos</h4>

        <a class="btn btn-primary" asp-action="CargaAcademica">Ver Carga Académica</a>
    </div>
</div>
