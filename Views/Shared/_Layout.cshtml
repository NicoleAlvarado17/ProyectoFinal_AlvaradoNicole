@{
    // Si una cuenta llegara a tener más de un rol asignado (por ejemplo, un
    // Admin que además quedó con el rol Estudiante de una prueba anterior),
    // se muestra un solo panel de navegación, con esta prioridad, para no
    // apilar varias barras de menú a la vez.
    var esAdmin = User.IsInRole("Admin");
    var esDocente = !esAdmin && User.IsInRole("Docente");
    var esEstudiante = !esAdmin && !esDocente && User.IsInRole("Estudiante");

    var controllerActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var esInicio = controllerActual == "Home" && accionActual == "Index";

    // El plan de estudios de una carrera es una página pública informativa
    // (a la que se llega desde "Ver más" en el inicio): debe verse siempre
    // igual para cualquiera, sin el panel de administración/docente/estudiante
    // aunque quien la mire haya iniciado sesión con ese rol.
    var esPaginaPublica = esInicio || (controllerActual == "Carreras" && accionActual == "PlanEstudios");

    string ClaseActiva(string controlador) => controllerActual == controlador ? "active" : "";
    string ClaseActivaHome(string accion) => (controllerActual == "Home" && accionActual == accion) ? "active" : "";

    var mostrarSidebar = (esAdmin || esDocente || esEstudiante) && !esPaginaPublica;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Matrícula • Universidad Real Americana</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body style="background-color:#F8F9FA;">

    <header class="ura-header">
    <div class="container d-flex align-items-center justify-content-between py-3">

        <div class="d-flex align-items-center">
            <img src="~/img/logo-ura.png" style="height:70px;" class="me-3" />
            <h2 class="text-white fw-bold mb-0">Universidad Real Americana</h2>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated && !esInicio)
        {
            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-warning btn-sm">Salir</a>

            </div>
        }

    </div>
</header>

    <div class="ura-layout">

        @if (mostrarSidebar)
        {
            <aside class="ura-sidebar">
                @if (esAdmin)
                {
                    <div class="ura-sidebar-title">Panel Administrativo</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @ClaseActiva("Admin")" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ClaseActiva("EstudiantesAdmin")" asp-controller="EstudiantesAdmin" asp-action="Index">Gestión de Estudiantes</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ClaseActiva("Docentes")" asp-controller="Docentes" asp-action="Index">Gestión de Profesores</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ClaseActiva("Carreras")" asp-controller="Carreras" asp-action="Index">Gestión de Carreras</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ClaseActiva("CursosAdmin")" asp-controller="CursosAdmin" asp-action="Index">Gestión de Cursos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ClaseActiva("Matriculas")" asp-controller="Matriculas" asp-action="Auditoria">Auditoría de Matrículas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @ClaseActiva("Usuarios")" asp-controller="Usuarios" asp-action="Index">Gestión de Usuarios</a>
                        </li>
                    </ul>
                }
                else if (esDocente)
                {
                    <div class="ura-sidebar-title">Panel Docente</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @ClaseActiva("PanelDocente")" asp-controller="PanelDocente" asp-action="DashboardDocente">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PanelDocente" asp-action="CargaAcademica">Carga Académica</a>
                        </li>
                    </ul>
                }
                else if (esEstudiante)
                {
                    <div class="ura-sidebar-title">Panel Estudiante</div>
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link @ClaseActivaHome("Dashboard")" asp-controller="Home" asp-action="Dashboard">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerActual == "Estudiante" && accionActual == "Cursos" ? "active" : "")" asp-controller="Estudiante" asp-action="Cursos">Cursos Disponibles</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerActual == "Estudiante" && accionActual == "MisCursos" ? "active" : "")" asp-controller="Estudiante" asp-action="MisCursos">Mis Cursos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controllerActual == "Estudiante" && accionActual == "Historial" ? "active" : "")" asp-controller="Estudiante" asp-action="Historial">Historial</a>
                        </li>
                    </ul>
                }
            </aside>
        }

        <div class="ura-content">
            <div class="@(mostrarSidebar ? "container-fluid" : "container") mt-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>

    </div>

    <footer class="ura-footer text-center mt-5 py-3">
        <div class="container">
            &copy; 2026 - Sistema de Matrícula • Universidad Real Americana
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
