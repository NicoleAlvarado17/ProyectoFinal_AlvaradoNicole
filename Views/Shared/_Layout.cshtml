<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Matrícula • Universidad Real Americana</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body style="background-color:#f5f5f5;">

    <header class="ura-header">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center">
                <img src="~/img/logo-ura.png" style="height:70px;" class="me-3" />
                <h2 class="text-white fw-bold mb-0">Universidad Real Americana</h2>
            </div>

            @if (User.Identity != null && User.Identity.IsAuthenticated &&
                 !(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
                   ViewContext.RouteData.Values["action"]?.ToString() == "Index"))
            {
                <div class="d-flex align-items-center gap-2">
                    <form asp-page="/Account/Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-warning btn-sm">Salir</button>
                    </form>
                </div>
            }
        </div>
    </header>

    @* MENÚ DEL ADMIN  *@
    @if (User.IsInRole("Admin") &&
        !(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
          ViewContext.RouteData.Values["action"]?.ToString() == "Index"))
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold">Panel Administrativo</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar"
                        aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="EstudiantesAdmin" asp-action="Index">
                                Gestión de Estudiantes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Docentes" asp-action="Index">
                                Gestión de Profesores
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Carreras" asp-action="Index">
                                Gestión de Carreras
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cursos" asp-action="Index">
                                Gestión de Cursos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Matriculas" asp-action="Auditoria">
                                Auditoría de Matrículas
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    }

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="ura-footer text-center mt-5 py-3">
        <div class="container">
            &copy; 2026 - Sistema de Matrícula • Universidad Real Americana
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
