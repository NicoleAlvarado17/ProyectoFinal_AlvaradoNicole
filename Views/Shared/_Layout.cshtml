@{
    // Si una cuenta llegara a tener más de un rol asignado (por ejemplo, un
    // Admin que además quedó con el rol Estudiante de una prueba anterior),
    // se muestra un solo panel de navegación, con esta prioridad, para no
    // apilar varias barras de menú a la vez.
    var esAdmin = User.IsInRole("Admin");
    var esDocente = !esAdmin && User.IsInRole("Docente");
    var esEstudiante = !esAdmin && !esDocente && User.IsInRole("Estudiante");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Matrícula • Universidad Real Americana</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body style="background-color:#f5f5f5;">

    <header class="ura-header">
    <div class="container d-flex align-items-center justify-content-between py-3">

        <div class="d-flex align-items-center">
            <img src="~/img/logo-ura.png" style="height:70px;" class="me-3" />
            <h2 class="text-white fw-bold mb-0">Universidad Real Americana</h2>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated &&
             !(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
               ViewContext.RouteData.Values["action"]?.ToString() == "Index"))
        {
            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-warning btn-sm">Salir</a>

            </div>
        }

    </div>
</header>


    @* MENÚ DEL ADMIN *@
    @if (esAdmin &&
        !(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
          ViewContext.RouteData.Values["action"]?.ToString() == "Index"))
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold">Panel Administrativo</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar"
                        aria-controls="adminNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="EstudiantesAdmin" asp-action="Index">
                                Gestión de Estudiantes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Docentes" asp-action="Index">
                                Gestión de Profesores
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Carreras" asp-action="Index">
                                Gestión de Carreras
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CursosAdmin" asp-action="Index">
                                Gestión de Cursos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Matriculas" asp-action="Auditoria">
                                Auditoría de Matrículas
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usuarios" asp-action="Index">
                                Gestión de Usuarios
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    }

    @* MENÚ DEL DOCENTE *@
    @if (esDocente &&
        !(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
          ViewContext.RouteData.Values["action"]?.ToString() == "Index"))
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="PanelDocente" asp-action="DashboardDocente">Panel Docente</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#docenteNavbar"
                        aria-controls="docenteNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="docenteNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PanelDocente" asp-action="DashboardDocente">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PanelDocente" asp-action="CargaAcademica">
                                Carga Académica
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    }

    @* MENÚ DEL ESTUDIANTE *@
    @if (esEstudiante &&
        !(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" &&
          ViewContext.RouteData.Values["action"]?.ToString() == "Index"))
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-3">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Dashboard">Panel Estudiante</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#estudianteNavbar"
                        aria-controls="estudianteNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="estudianteNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Dashboard">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Estudiante" asp-action="Cursos">
                                Cursos Disponibles
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Estudiante" asp-action="MisCursos">
                                Mis Cursos
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    }

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="ura-footer text-center mt-5 py-3">
        <div class="container">
            &copy; 2026 - Sistema de Matrícula • Universidad Real Americana
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
