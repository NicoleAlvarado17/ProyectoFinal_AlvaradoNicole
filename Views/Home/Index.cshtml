@{
    ViewData["Title"] = "Página de Inicio";
}

<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Tu futuro empieza aquí</h1>
        <p class="hero-subtitle">
            Más de 18 carreras acreditadas · 4 sedes · Modalidad presencial y virtual
        </p>

        <div class="hero-buttons">
            <!-- BOTONES CORREGIDOS -->
            <a asp-page="/Account/Login" class="btn btn-primary btn-lg me-3">Ingresar</a>
            <a asp-page="/Account/Register" class="btn btn-warning btn-lg">Registrarse</a>
        </div>
    </div>

    <div class="promo-box">
        <h3 class="promo-title">15% de descuento</h3>
        <p class="promo-text">
            Para estudiantes que se matriculen antes del <strong>30 de junio</strong>.
            Aplica para nuevos ingresos en todos los programas.
        </p>
    </div>
</div>

<hr class="section-divider" />

<h2 class="section-title">Carreras Destacadas</h2>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card carrera-card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Ingeniería en Sistemas (IS)</h5>
                <a class="btn btn-primary" asp-controller="Carreras" asp-action="Index">Ver más</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card carrera-card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Administración (AD)</h5>
                <a class="btn btn-primary" asp-controller="Carreras" asp-action="Index">Ver más</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card carrera-card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Enfermería (EN)</h5>
                <a class="btn btn-primary" asp-controller="Carreras" asp-action="Index">Ver más</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card carrera-card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Derecho (DE)</h5>
                <a class="btn btn-primary" asp-controller="Carreras" asp-action="Index">Ver más</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card carrera-card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Educación (ED)</h5>
                <a class="btn btn-primary" asp-controller="Carreras" asp-action="Index">Ver más</a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card carrera-card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Contabilidad (CO)</h5>
                <a class="btn btn-primary" asp-controller="Carreras" asp-action="Index">Ver más</a>
            </div>
        </div>
    </div>
</div>

<hr class="section-divider" />

<div class="contact-section">
    <h2 class="section-title">Contáctenos</h2>
    <p><strong>Teléfono:</strong> +506 2222-3344</p>
    <p><strong>Email:</strong> info@universidadrealamericana.edu</p>
    <p><strong>Horario:</strong> Lun a Vie · 8:00 a.m. – 6:00 p.m.</p>
</div>

<footer class="footer mt-5">
    <p class="text-center">Sistema de Matrícula • Universidad Real Americana</p>
</footer>
