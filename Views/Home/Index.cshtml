@model IEnumerable<SistemaMatriculaURA.Models.Carrera>
@{
    ViewData["Title"] = "Página de Inicio";
}

<div class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Tu futuro empieza aquí</h1>
        <p class="hero-subtitle">
            Más de 18 carreras acreditadas · 4 sedes · Modalidad presencial y virtual
        </p>

        <div class="hero-buttons">
            <a asp-page="/Account/Login" class="btn btn-warning btn-lg me-3">Ingresar</a>
            <a asp-page="/Account/Register" class="btn btn-primary btn-lg">Registrarse</a>
        </div>
    </div>

    <div class="promo-box">
        <h3 class="promo-title">15% de descuento</h3>
        <p class="promo-text">
            Para estudiantes que se matriculen antes del <strong>30 de junio</strong>.
            Aplica para nuevos ingresos en todos los programas.
        </p>
    </div>
</div>

<hr class="section-divider" />

<div class="d-flex justify-content-between align-items-center">
    <h2 class="section-title mb-0">Carreras Destacadas</h2>
    <a asp-controller="Carreras" asp-action="Index" class="ura-link">Ver todas &rarr;</a>
</div>

<div class="row mt-4">
    @if (!Model.Any())
    {
        <p class="text-muted">Todavía no hay carreras registradas.</p>
    }
    else
    {
        @foreach (var carrera in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card carrera-card shadow-sm">
                    <div class="card-body">
                        <div class="carrera-badge">@carrera.Nombre.Substring(0, Math.Min(2, carrera.Nombre.Length)).ToUpper()</div>
                        <h5 class="card-title">@carrera.Nombre</h5>
                        <a class="btn btn-primary btn-sm" asp-controller="Carreras" asp-action="PlanEstudios" asp-route-id="@carrera.Id">Ver más</a>
                    </div>
                </div>
            </div>
        }
    }
</div>

<hr class="section-divider" />

<div class="contact-section">
    <h2 class="section-title">Contáctenos</h2>
    <p><strong>Teléfono:</strong> +506 2222-3344</p>
    <p><strong>Email:</strong> info@universidadrealamericana.edu</p>
    <p><strong>Horario:</strong> Lun a Vie · 8:00 a.m. – 6:00 p.m.</p>
</div>
