@page
@model ProyectoFinal_AlvaradoNicole.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutAuth";
}

<div class="ura-auth-badge">URA</div>

<h2 class="ura-title mb-1">Iniciar Sesión</h2>
<p class="text-center text-muted mb-4">Universidad Real Americana</p>

<form method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Correo electrónico</label>
        <input asp-for="Input.Email" class="form-control" placeholder="usuario@ura.edu" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label class="form-label">Contraseña</label>
        <input asp-for="Input.Password" class="form-control" type="password" placeholder="••••••••••" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Ingresar</button>

    <div class="text-center mt-3">
        <a asp-page="./ForgotPassword" class="ura-link">¿Olvidó Contraseña?</a>
    </div>
</form>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
