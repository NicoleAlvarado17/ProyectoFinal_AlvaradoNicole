@page
@model ProyectoFinal_AlvaradoNicole.Pages.Account.RegisterModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Registro de Estudiante";
}

<div class="ura-box mt-5">
    <img src="~/img/logo-ura.png" class="ura-logo" />

    <h2 class="ura-title">Crear cuenta </h2>

    <form method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="mb-3">
            <label>Nombre completo</label>
            <input asp-for="Input.FullName" class="form-control" />
            <span asp-validation-for="Input.FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Correo electrónico</label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Contraseña</label>
            <input asp-for="Input.Password" class="form-control" type="password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label>Carrera</label>
            <select asp-for="Input.Carrera" class="form-control">
                <option>Ingeniería en Sistemas</option>
                <option>Administración</option>
                <option>Enfermería</option>
                <option>Derecho</option>
                <option>Educación</option>
                <option>Contabilidad</option>
            </select>
        </div>

        <button type="submit" class="btn btn-warning w-100">Crear cuenta</button>
    </form>
</div>

@section Scripts {
    <partial name="~/Views/Shared/_ValidationScriptsPartial.cshtml" />
}
